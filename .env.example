# --- Coordonnées affichées sur le site (page contact, footer, emails) ---
# CONTACT_EMAIL reçoit aussi les notifications de nouvelle commande
CONTACT_EMAIL=contact@brennstoffenagler.de
CONTACT_TELEPHONE=+49 151 23456789
CONTACT_ADRESSE=Waldweg 12, 99423 Weimar, Deutschland

# --- Stockage d'images (Vercel Blob) ---
# Token depuis Vercel > Storage > Blob (accès lecture/écriture)
BLOB_READ_WRITE_TOKEN=

# --- Application ---
NEXT_PUBLIC_APP_URL=https://www.brennstoffenagler.de
NEXT_PUBLIC_SITE_URL=https://www.brennstoffenagler.de
# Compte administrateur initial créé par le script de seed (src/scripts/seed.ts)
SEED_ADMIN_EMAIL=contact@brennstoffenagler.de
SEED_ADMIN_PASSWORD=ChangezMoi123!
# Sur Vercel, le seed ne ré-écrit le catalogue que si la base est vide.
# Mettre SEED_FORCE=true uniquement pour forcer une ré-écriture.
SEED_FORCE=false
